# LandSignal environment — never commit real secrets

# API
STORE_BACKEND=memory
DEMO_SEED=true
DATABASE_URL=postgresql+asyncpg://landsignal:landsignal@localhost:5432/landsignal
REDIS_URL=redis://localhost:6379/0
ENABLE_LIVE_GOV_ENRICHMENT=true

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/v1
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_TOKEN=

# Licensed listing / parcel vendors (absence => NOT_CONFIGURED)
MLS_RESO_TOKEN=
LAND_COM_API_KEY=
CREXI_API_KEY=
REGRID_API_KEY=

# Alert delivery (absence => NOT_CONFIGURED)
SMTP_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
