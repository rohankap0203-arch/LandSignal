# LandSignal environment — never commit real secrets

# API
STORE_BACKEND=memory
DEMO_SEED=true
DATABASE_URL=postgresql+asyncpg://landsignal:landsignal@localhost:5432/landsignal
REDIS_URL=redis://localhost:6379/0
ENABLE_LIVE_GOV_ENRICHMENT=true

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/v1
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_TOKEN=

# Auth (Auth.js / NextAuth) — Google & Apple Sign In
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Optional absolute URL in production, e.g. https://app.landsignal.com
AUTH_URL=
# When OAuth IDs/secrets are unset, Google/Apple still create a real local session.
# Set AUTH_DEMO_OAUTH=false to require real vendor OAuth only.
AUTH_DEMO_OAUTH=true
AUTH_TRUST_HOST=true
# Google Cloud Console → OAuth client (Web):
#   Authorized redirect URI: https://YOUR_HOST/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Apple Developer → Services ID:
#   Return URL: https://YOUR_HOST/api/auth/callback/apple
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# Licensed listing / parcel vendors (absence => NOT_CONFIGURED)
MLS_RESO_TOKEN=
LAND_COM_API_KEY=
CREXI_API_KEY=
REGRID_API_KEY=

# ATTOM Property API (server-side only — never put this in NEXT_PUBLIC_*)
# Leave blank to run without ATTOM; Show Matches still works via public GIS / BLM.
ATTOM_API_KEY=
# api | bulk | disabled  (bulk reserved for a future licensed bulk feed)
ATTOM_DATA_MODE=api
# Must stay ≤ 86400 under current ATTOM API retention terms
ATTOM_CACHE_TTL_SECONDS=82800
ATTOM_ENRICH_ON_ANALYZE=true
ATTOM_ENRICH_TOP_N=40

# Alert delivery (absence => NOT_CONFIGURED)
SMTP_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
