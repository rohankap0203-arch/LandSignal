{
  "name": "landsignal",
  "private": true,
  "version": "0.1.0",
  "description": "Institutional land acquisition intelligence platform",
  "scripts": {
    "test:scoring": "npm --prefix packages/scoring test",
    "test:api": "cd apps/api && .venv/bin/pytest -q",
    "dev:api": "cd apps/api && set -a && [ -f .env ] && . ./.env; set +a && .venv/bin/uvicorn landsignal.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:web": "npm --prefix apps/web run dev -- -H 0.0.0.0 -p 3000",
    "dev": "bash scripts/dev-servers.sh"
  }
}
